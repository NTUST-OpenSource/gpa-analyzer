# Copy to .env. Values already exported in the shell take precedence over
# anything set here.

# Fernet key used to encrypt session cookies. Required.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Send session cookies only over HTTPS. Keep true in production.
COOKIE_SECURE=true

# Address and port the server listens on.
HOST=0.0.0.0
PORT=8000

# Directory for the scraper's on-disk caches.
CACHE_DIR=.cache

# Peers allowed to set X-Forwarded-For. Set this to your reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Extra hostnames accepted in the Origin header, comma separated. Only needed
# when a proxy rewrites the Host header, which would otherwise reject sign-ins.
TRUSTED_ORIGINS=

# Rate limits, each counted over a 5 minute window. Failures and API calls are
# counted per account; only sign-in attempts are counted per IP, so a campus
# NAT sharing one address is the case to raise LOGIN_ATTEMPT_LIMIT for.
LOGIN_FAILURE_LIMIT=5
LOGIN_ATTEMPT_LIMIT=10
API_RATE_LIMIT=10

# Optional: credentials for the `python -m gpa_analyzer.analyzer` CLI only.
# The web application never reads these.
NTUST_USERNAME=
NTUST_PASSWORD=
