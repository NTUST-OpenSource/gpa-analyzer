# Fernet key used to encrypt session cookies. Required.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Send session cookies only over HTTPS. Keep true in production.
COOKIE_SECURE=true

# Port the server listens on.
PORT=8000

# Directory for the scraper's on-disk caches.
CACHE_DIR=.cache

# Peers allowed to set X-Forwarded-For. Set this to your reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Extra hostnames accepted in the Origin header, comma separated. Only needed
# when a proxy rewrites the Host header, which would otherwise reject sign-ins.
TRUSTED_ORIGINS=

# Rate limits, each counted over a 5 minute window.
# Failures per account and per IP; raise the attempt cap if many students share
# one address behind a campus NAT.
LOGIN_FAILURE_LIMIT=5
LOGIN_ATTEMPT_LIMIT=120
API_RATE_LIMIT=30

# Optional: credentials for the GpaAnalyzer.py CLI entry point only.
# The web application never reads these.
NTUST_USERNAME=
NTUST_PASSWORD=
